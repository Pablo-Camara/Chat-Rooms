APP_NAME="Chat Rooms"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8088
APP_PORT=8088
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlite
DB_DATABASE=/app/database/database.sqlite
DB_FOREIGN_KEYS=true
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_COOKIE=chat_rooms_session
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=localhost:8088,127.0.0.1:8088
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=reverb
REVERB_APP_ID=chat-rooms-local
REVERB_APP_KEY=chat-rooms-local
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_PUBLIC_PORT=8089
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8089
VITE_REVERB_SCHEME=http
